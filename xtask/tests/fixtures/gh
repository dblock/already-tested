#!/bin/sh
set -eu
printf '%s\n' "$*" >> "$MOCK/events"
command=$1
shift
case "$command" in
  api) cat "$MOCK/tag-sha" ;;
  release)
    operation=$1
    tag=$2
    shift 2
    case "$operation" in
      view)
        test -f "$MOCK/released"
        case "$*" in
          *isDraft,isPrerelease*) test ! -f "$MOCK/draft" && printf 'true\n' || printf 'false\n' ;;
          *assets*) ls "$MOCK/assets" ;;
          *) printf '{"tagName":"%s"}\n' "$tag" ;;
        esac ;;
      upload)
        test ! -f "$MOCK/assets/$(basename "$1")"
        cp -- "$1" "$MOCK/assets/$(basename "$1")"
        if [ -f "$MOCK/fail-upload" ]; then
          rm -- "$MOCK/fail-upload"
          exit 1
        fi ;;
      download)
        pattern=
        destination=
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --pattern) pattern=$2; shift 2 ;;
            --dir) destination=$2; shift 2 ;;
            *) exit 1 ;;
          esac
        done
        cp -- "$MOCK/assets/$pattern" "$destination/$pattern" ;;
      *) exit 1 ;;
    esac ;;
  *) exit 1 ;;
esac
